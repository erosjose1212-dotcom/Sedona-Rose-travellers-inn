[PHP]
extension_dir="@PHP_ROOT@/ext"
extension=mbstring
extension=openssl
extension=fileinfo
extension=pdo_sqlite
extension=sqlite3
extension=curl
extension=zip
extension=gd
extension=exif
memory_limit=512M
max_execution_time=120
upload_max_filesize=40M
post_max_size=40M
date.timezone=Asia/Manila
expose_php=Off
display_errors=Off
display_startup_errors=Off
log_errors=On
error_log="@PROJECT_ROOT@/storage/logs/php-error.log"
sys_temp_dir="@PROJECT_ROOT@/storage/app/private/tmp"
upload_tmp_dir="@PROJECT_ROOT@/storage/app/private/tmp"
session.save_path="@PROJECT_ROOT@/storage/framework/sessions"
